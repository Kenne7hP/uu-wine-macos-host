--- a/dlls/user32/input.c
+++ b/dlls/user32/input.c
@@ -26,11 +26,26 @@
 
 #include "user_private.h"
 #include "dbt.h"
+#include "ntgdi.h"
 #include "wine/debug.h"
 #include "wine/plugplay.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 WINE_DECLARE_DEBUG_CHANNEL(keyboard);
+
+UINT WINAPI SendInput(UINT count, INPUT *input, int size)
+{
+    if (input && count && size == sizeof(*input) && GetEnvironmentVariableW(L"UU_MAC_INPUT", NULL, 0))
+    {
+        HDC dc = NtUserGetDC(0);
+        UINT i;
+        for (i=0; dc && i<count; ++i)
+            if (NtGdiExtEscape(dc, NULL, 0, 0x5555494e, size, (const char *)(input+i), 0, NULL)!=1) break;
+        if (dc) NtUserReleaseDC(0, dc);
+        if (i) return i;
+    }
+    return NtUserSendInput(count,input,size);
+}
 

+/* Read only the frame file explicitly provided to this test Wine instance. */
+static DWORD read_desktop_image(PHYSDEV dev, BITMAPINFO *info, struct gdi_image_bits *bits,
+                                struct bitblt_coords *src)
+{
+    const char *path = getenv("UU_TEST_FRAME_FILE");
+    struct stat st;
+    uint32_t header[UURF_HEADER_BYTES / 4];
+    size_t bytes, slot_size;
+    uint64_t frame, seq, after;
+    off_t offset;
+    unsigned char *pixels = NULL;
+    DWORD result = ERROR_NOT_SUPPORTED;
+    int fd;
+    if (!path || !get_macdrv_dev(dev)->desktop_capture) goto fallback;
+    fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) goto fallback;
+    if (fstat(fd,&st) || !S_ISREG(st.st_mode) || st.st_uid != getuid() || (st.st_mode & 077) ||
+        pread(fd,header,sizeof(header),0) != sizeof(header) ||
+        header[0] != UURF_MAGIC || header[1] != UURF_VERSION || header[5] != 1 ||
+        !header[2] || !header[3] || header[2]>16384 || header[3]>16384 ||
+        header[4] != 4*header[2]) goto done;
+    bytes = (size_t)header[4]*header[3];
+    slot_size = 8 + bytes;
+    if (bytes > 256*1024*1024 || st.st_size != UURF_HEADER_BYTES+UURF_SLOT_COUNT*slot_size) goto done;
+    if (src && (src->visrect.left<0 || src->visrect.top<0 ||
+                src->visrect.right>(int)header[2] || src->visrect.bottom>(int)header[3])) goto done;
+    if (bits)
+    {
+        pixels = malloc(bytes);
+        if (!pixels) { result=ERROR_OUTOFMEMORY; goto done; }
+        for (unsigned attempt=0; attempt<3; attempt++)
+        {
+            if (pread(fd,&frame,8,24)!=8 || !frame) goto done;
+            offset = uurf_slot_offset(frame,slot_size);
+            if (pread(fd,&seq,8,offset)!=8 || seq!=2*frame) continue;
+            if (pread(fd,pixels,bytes,offset+8)!=(ssize_t)bytes) goto done;
+            if (pread(fd,&after,8,offset)!=8 || seq!=after) continue;
+            bits->ptr=pixels; bits->is_copy=TRUE; bits->free=release_frame_bits;
+            pixels=NULL;
+            TRACE("UU_FRAME_READ frame=%llu width=%u height=%u\n", (unsigned long long)frame,header[2],header[3]);
+            break;
+        }
+        if (pixels) goto done;
+    }
+    info->bmiHeader=(BITMAPINFOHEADER){.biSize=sizeof(BITMAPINFOHEADER),.biWidth=header[2],
+        .biHeight=-(int)header[3],.biPlanes=1,.biBitCount=32,.biCompression=BI_RGB,.biSizeImage=bytes};
+    result=ERROR_SUCCESS;
+done:
+    free(pixels);
+    close(fd);
+    return result;
+fallback:
+    dev=GET_NEXT_PHYSDEV(dev,pGetImage);
+    return dev->funcs->pGetImage(dev,info,bits,src);
+}

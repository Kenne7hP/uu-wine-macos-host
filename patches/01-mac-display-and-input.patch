+static INT mac_input_escape(PHYSDEV dev, INT escape, INT size, LPCVOID raw, INT out_size, LPVOID out)
+{
+    if (escape==0x5555494e)
+    {
+        const char *scope=getenv("UU_MAC_INPUT");
+        const INPUT *input=raw;
+        pid_t target=0;
+        if (!scope || !raw || size!=sizeof(*input)) return 0;
+        if (strcmp(scope,"desktop")) {
+            char *end=NULL;
+            long value=strtol(scope,&end,10);
+            if (!end || *end || value<=1 || value>INT_MAX) return 0;
+            target=(pid_t)value;
+        }
+        if (!CGPreflightPostEventAccess()) return 0;
+        BOOL posted=input->type==INPUT_MOUSE ? post_mac_mouse(&input->mi,target) :
+                    input->type==INPUT_KEYBOARD && post_mac_key(&input->ki,target);
+        if(posted) TRACE("UU_MAC_INPUT_POST category=%s\n",input->type==INPUT_MOUSE?"pointer":"keyboard");
+        return posted;
+    }
+    dev=GET_NEXT_PHYSDEV(dev,pExtEscape);
+    return dev->funcs->pExtEscape(dev,escape,size,raw,out_size,out);
+}
 

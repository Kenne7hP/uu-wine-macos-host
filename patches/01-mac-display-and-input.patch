+static BOOL post_mac_input(CGEventRef event, pid_t target)
+{
+    if (!event) return FALSE;
+    CGEventSetIntegerValueField(event,kCGEventSourceUserData,764038);
+    if(target)
+    {
+        ProcessSerialNumber front;
+        pid_t pid;
+        if(GetFrontProcess(&front) || GetProcessPID(&front,&pid) || pid!=target) {
+            CFRelease(event);
+            return FALSE;
+        }
+    }
+    CGEventPost(kCGHIDEventTap,event);
+    CFRelease(event);
+    return TRUE;
+}
+
+static BOOL post_mac_key(const KEYBDINPUT *key, pid_t target)
+{
+    struct macdrv_thread_data *data=macdrv_init_thread_data();
+    WORD vk=key->wVk, scan=key->wScan;
+    BOOL down=!(key->dwFlags & KEYEVENTF_KEYUP);
+    CGEventRef event;
+    if (key->dwFlags & KEYEVENTF_UNICODE)
+    {
+        event=CGEventCreateKeyboardEvent(NULL,0,down);
+        if (event) CGEventKeyboardSetUnicodeString(event,1,&scan);
+        return post_mac_input(event,target);
+    }
+    if (!data) return FALSE;
+    if (vk==VK_SHIFT) vk=scan==0x36?VK_RSHIFT:VK_LSHIFT;
+    if (vk==VK_CONTROL) vk=(key->dwFlags&KEYEVENTF_EXTENDEDKEY)?VK_RCONTROL:VK_LCONTROL;
+    if (vk==VK_MENU) vk=(key->dwFlags&KEYEVENTF_EXTENDEDKEY)?VK_RMENU:VK_LMENU;
+    for (int k=0;k<ARRAY_SIZE(data->keyc2vkey);k++)
+    {
+        if ((key->dwFlags&KEYEVENTF_SCANCODE) || !vk) {
+            if (!scan || data->keyc2scan[k]!=(scan|((key->dwFlags&KEYEVENTF_EXTENDEDKEY)?0x100:0))) continue;
+        } else if (data->keyc2vkey[k]!=vk) continue;
+        return post_mac_input(CGEventCreateKeyboardEvent(NULL,k,down),target);
+    }
+    return FALSE;
+}
+
+static BOOL post_mac_mouse(const MOUSEINPUT *mouse,pid_t target)
+{
+    static const struct {DWORD mask; CGEventType type; CGMouseButton button;} buttons[]={
+        {MOUSEEVENTF_LEFTDOWN,kCGEventLeftMouseDown,0},{MOUSEEVENTF_LEFTUP,kCGEventLeftMouseUp,0},
+        {MOUSEEVENTF_RIGHTDOWN,kCGEventRightMouseDown,1},{MOUSEEVENTF_RIGHTUP,kCGEventRightMouseUp,1},
+        {MOUSEEVENTF_MIDDLEDOWN,kCGEventOtherMouseDown,2},{MOUSEEVENTF_MIDDLEUP,kCGEventOtherMouseUp,2}};
+    CGEventRef current=CGEventCreate(NULL);
+    if (!current) return FALSE;
+    CGPoint pt=CGEventGetLocation(current);
+    CFRelease(current);
+    DWORD flags=mouse->dwFlags;
+    if (flags&MOUSEEVENTF_MOVE)
+    {
+        CGRect display=CGDisplayBounds(CGMainDisplayID());
+        if(flags&MOUSEEVENTF_ABSOLUTE)
+        {
+            pt.x=display.origin.x+mouse->dx*(display.size.width-1)/65535.;
+            pt.y=display.origin.y+mouse->dy*(display.size.height-1)/65535.;
+        }
+        else {pt.x+=mouse->dx;pt.y+=mouse->dy;}
+        pt.x=fmax(CGRectGetMinX(display),fmin(CGRectGetMaxX(display)-1,pt.x));
+        pt.y=fmax(CGRectGetMinY(display),fmin(CGRectGetMaxY(display)-1,pt.y));
+        CGEventType type=kCGEventMouseMoved;
+        CGMouseButton button=kCGMouseButtonLeft;
+        if(CGEventSourceButtonState(kCGEventSourceStateCombinedSessionState,0)) type=kCGEventLeftMouseDragged;
+        else if(CGEventSourceButtonState(kCGEventSourceStateCombinedSessionState,1)) {type=kCGEventRightMouseDragged;button=1;}
+        else if(CGEventSourceButtonState(kCGEventSourceStateCombinedSessionState,2)) {type=kCGEventOtherMouseDragged;button=2;}
+        if(!post_mac_input(CGEventCreateMouseEvent(NULL,type,pt,button),target)) return FALSE;
+    }
+    for(unsigned i=0;i<ARRAY_SIZE(buttons);i++) if(flags&buttons[i].mask)
+    {
+        CGEventRef e=CGEventCreateMouseEvent(NULL,buttons[i].type,pt,buttons[i].button);
+        if(e) CGEventSetIntegerValueField(e,kCGMouseEventClickState,1);
+        if(!post_mac_input(e,target)) return FALSE;
+    }
+    if(flags&(MOUSEEVENTF_WHEEL|MOUSEEVENTF_HWHEEL))
+    {
+        int delta=(int)mouse->mouseData/120;
+        if (!post_mac_input(CGEventCreateScrollWheelEvent(NULL,kCGScrollEventUnitLine,2,
+            (flags&MOUSEEVENTF_WHEEL)?delta:0,(flags&MOUSEEVENTF_HWHEEL)?delta:0),target)) return FALSE;
+    }
+    return !!(flags&(MOUSEEVENTF_MOVE|MOUSEEVENTF_LEFTDOWN|MOUSEEVENTF_LEFTUP|MOUSEEVENTF_RIGHTDOWN|
+        MOUSEEVENTF_RIGHTUP|MOUSEEVENTF_MIDDLEDOWN|MOUSEEVENTF_MIDDLEUP|MOUSEEVENTF_WHEEL|MOUSEEVENTF_HWHEEL));
+}
